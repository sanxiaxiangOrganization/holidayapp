/* pages/room_reservation/room_reservation.wxss */
.container {
  padding: 20rpx;
  gap: 60rpx;
  min-height: 100vh;
}

.room-swiper {
  width: 100%;
  height: 300rpx;
}

.room-image {
  width: 100%;
  height: 100%;
}

.room-title {
  font-size: 32rpx;
  font-weight: bold;
}

.room-description {
  font-size: 28rpx;
  color: #666;
  margin-top: 10rpx;
}

.reservation-section {
  width: 100%;
}

.reservation-title {
  font-size: 30rpx;
  font-weight: bold;
}

.date-picker {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.picker {
  font-size: 28rpx;
  border: 1px solid #ccc;
  padding: 10rpx 20rpx;
  border-radius: 5rpx;
}

.reservation-btn {
  margin-top: 30rpx;
  background-color: #007aff;
  color: white;
  padding: 15rpx 0;
  text-align: center;
  border-radius: 5rpx;
}

.comment-list {
  flex: 1;
  width: 100%;
}

.comment-title {
  font-size: 30rpx;
  font-weight: bold;
}

.comment-item {
  margin-top: 20rpx;
  border: 1px solid #eee;
  padding: 20rpx;
  border-radius: 5rpx;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}

.comment-content {
  font-size: 28rpx;
  margin-top: 10rpx;
}